# Copy to .env and fill in locally. Never commit real tokens or API keys.
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=
# Optional. When absent, Hindi scripts use the offline rule-based fallback.
GEMINI_API_KEY=
# Optional: qwen2.5 / another Ollama model. Ollama must be running locally.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
DATA_DIR=./data
ASSETS_DIR=./assets
OUTPUT_DIR=./work
WHISPER_MODEL=base
MAX_VIDEO_MB=20
CLIP_SECONDS=38
